<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="coinbase_checkout" translate="label comment" type="text" sortOrder="100"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Coinbase Business</label>
                <comment><![CDATA[Accept USDC payments via Coinbase. <a href="https://docs.cdp.coinbase.com" target="_blank">Documentation</a>]]></comment>
                <field id="active" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                </field>
                <field id="environment" translate="label" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Environment</label>
                    <source_model>Coinbase\CheckoutGateway\Model\Adminhtml\Source\Environment</source_model>
                </field>
                <field id="api_key_name" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Key Name</label>
                    <comment><![CDATA[Your CDP API key name (e.g., organizations/{org_id}/apiKeys/{key_id})]]></comment>
                </field>
                <field id="api_private_key" translate="label comment" type="obscure" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>API Private Key (PEM)</label>
                    <comment><![CDATA[EC private key in PEM format for JWT signing (ECDSA ES256)]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="webhook_secret" translate="label comment" type="obscure" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Production Webhook Secret</label>
                    <comment><![CDATA[Secret from production webhook subscription for signature verification]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="environment">production</field>
                    </depends>
                </field>
                <field id="sandbox_webhook_secret" translate="label comment" type="obscure" sortOrder="61"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Sandbox Webhook Secret</label>
                    <comment><![CDATA[Secret from sandbox webhook subscription for signature verification]]></comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <depends>
                        <field id="environment">sandbox</field>
                    </depends>
                </field>
                <field id="expiration_hours" translate="label comment" type="text" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Checkout Expiration (Hours)</label>
                    <comment><![CDATA[Number of hours before a checkout expires (default: 24)]]></comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="debug" translate="label" type="select" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Debug Mode</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="allowspecific" translate="label" type="allowspecific" sortOrder="90"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Payment from Applicable Countries</label>
                    <source_model>Magento\Payment\Model\Config\Source\Allspecificcountries</source_model>
                </field>
                <field id="specificcountry" translate="label" type="multiselect" sortOrder="100"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Payment from Specific Countries</label>
                    <source_model>Magento\Directory\Model\Config\Source\Country</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="110"
                       showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Sort Order</label>
                    <validate>validate-number</validate>
                </field>
            </group>
        </section>
    </system>
</config>
