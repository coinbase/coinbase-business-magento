<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <coinbase_checkout>
                <active>0</active>
                <title>Pay with Coinbase (USDC)</title>
                <model>CoinbaseCheckoutFacade</model>
                <order_status>pending_payment</order_status>
                <environment>production</environment>
                <expiration_hours>24</expiration_hours>
                <can_initialize>1</can_initialize>
                <can_authorize>0</can_authorize>
                <can_capture>0</can_capture>
                <can_capture_partial>0</can_capture_partial>
                <can_refund>0</can_refund>
                <can_refund_partial>0</can_refund_partial>
                <can_void>0</can_void>
                <can_use_internal>0</can_use_internal>
                <can_use_checkout>1</can_use_checkout>
                <can_fetch_transaction_info>0</can_fetch_transaction_info>
                <is_gateway>1</is_gateway>
                <payment_action>initialize</payment_action>
                <debug>0</debug>
                <sort_order>100</sort_order>
            </coinbase_checkout>
        </payment>
    </default>
</config>
