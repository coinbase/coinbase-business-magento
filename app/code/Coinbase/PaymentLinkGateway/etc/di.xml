<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Payment Method Facade -->
    <virtualType name="CoinbasePaymentLinkFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">Coinbase\PaymentLinkGateway\Gateway\Config::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Coinbase\PaymentLinkGateway\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">CoinbasePaymentLinkValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">CoinbasePaymentLinkCommandPool</argument>
        </arguments>
    </virtualType>

    <!-- Value Handler Pool -->
    <virtualType name="CoinbasePaymentLinkValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">CoinbasePaymentLinkConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Config Value Handler -->
    <virtualType name="CoinbasePaymentLinkConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">Coinbase\PaymentLinkGateway\Gateway\Config</argument>
        </arguments>
    </virtualType>

    <!-- Command Pool -->
    <virtualType name="CoinbasePaymentLinkCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">CoinbasePaymentLinkInitializeCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Initialize Command -->
    <virtualType name="CoinbasePaymentLinkInitializeCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">CoinbasePaymentLinkInitializeRequest</argument>
            <argument name="transferFactory" xsi:type="object">Coinbase\PaymentLinkGateway\Gateway\Http\TransferFactory</argument>
            <argument name="client" xsi:type="object">Coinbase\PaymentLinkGateway\Gateway\Http\Client\PaymentLinkClient</argument>
            <argument name="handler" xsi:type="object">Coinbase\PaymentLinkGateway\Gateway\Response\PaymentLinkHandler</argument>
            <argument name="validator" xsi:type="object">Coinbase\PaymentLinkGateway\Gateway\Validator\ResponseValidator</argument>
        </arguments>
    </virtualType>

    <!-- Builder Composite for Initialize -->
    <virtualType name="CoinbasePaymentLinkInitializeRequest" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="payment_link" xsi:type="string">Coinbase\PaymentLinkGateway\Gateway\Request\PaymentLinkBuilder</item>
                <item name="payment_link_data" xsi:type="string">Coinbase\PaymentLinkGateway\Gateway\Request\PaymentLinkDataBuilder</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Gateway Config -->
    <type name="Coinbase\PaymentLinkGateway\Gateway\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Coinbase\PaymentLinkGateway\Gateway\Config::CODE</argument>
        </arguments>
    </type>

    <!-- Logger for debug -->
    <virtualType name="CoinbasePaymentLinkLogger" type="Magento\Payment\Model\Method\Logger">
        <arguments>
            <argument name="config" xsi:type="object">Coinbase\PaymentLinkGateway\Gateway\Config</argument>
        </arguments>
    </virtualType>

</config>
